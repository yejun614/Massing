{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Massing",
  "version": "0.1.5",
  "identifier": "dev.massing.editor",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../index.html": "editor/index.html",
      "../../src": "editor/src",
      "../../styles": "editor/styles",
      "../../examples": "editor/examples",
      "../web": "editor/desktop/web"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yejun614/Massing/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RTNCQzE0NDhDMDU0MzcKUldRM1ZNQklGTHpqRmNGaFhDNVZIS1R2UXc2LzB4TExvTnVaZnI5MXBoSExPck1sU2dpVzRQNWcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
