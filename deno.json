{
  // The local toolchain runs on Deno; the deployment does not, and the desktop
  // app no longer does either.
  //
  // `vercel.json` still says `node build.js` and `api/` is still built around
  // Node's `(req, res)` handlers, because that is what Vercel runs. The desktop
  // app moved to Tauri and is a Rust program; what is left here is the part
  // that builds and tests the editor itself, which runs on either runtime.
  //
  // `package.json` stays for the reason it always did: `"type": "module"` is
  // what makes Vercel parse `api/*.js` as ESM, and `engines.node` picks the
  // function runtime.
  "version": "0.1.0",
  "tasks": {
    // Permissions are named rather than `-A`, so the list itself says what the
    // build is allowed to touch. Read the tree, write `dist/` and the two
    // generated files, read the environment for MASSING_VERCEL_FEATURES.
    "build": "deno run --allow-read --allow-write --allow-env build.js",
    "test": "deno run --allow-read --allow-env test/run.mjs",

    // The desktop app builds with cargo. These are here so `deno task` lists
    // everything the repo can do rather than half of it.
    "dev": "cargo tauri dev",
    "desktop": "cargo tauri build",
    // Rust's own tests: the config-file writing, which is the part that edits
    // files people keep their own settings in.
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --lib",
    // The app end to end: starts the built binary, talks to it the way a CLI
    // would, stops it. A Node script rather than a Deno one, because it drives
    // a Rust binary and nothing about it needs a second runtime.
    "test:desktop": "node test/desktop.e2e.mjs"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    // The browser sources predate this config by a long way and are formatted
    // by hand to match a house style `deno fmt` does not share. `desktop/web/`
    // is browser code too -- it merely lives beside the shell. Nothing is left
    // for `deno fmt` to own, so it is pointed at nothing rather than at the
    // hand-formatted sources it would reflow.
    "include": []
  },
  "lint": {
    "include": []
  }
}
