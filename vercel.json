{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/d/:key",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
