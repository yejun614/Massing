{
  "name": "massing",
  "version": "0.1.4",
  "private": true,
  "description": "Isometric architecture diagram editor. No framework, no bundler, no dependencies.",
  "license": "MIT",
  "author": "YeJun Jung (https://github.com/yejun614)",
  "homepage": "https://github.com/yejun614/Massing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yejun614/Massing.git"
  },
  "bugs": {
    "url": "https://github.com/yejun614/Massing/issues"
  },
  "keywords": [
    "isometric",
    "architecture",
    "diagram",
    "editor",
    "svg"
  ],
  "type": "module",
  "scripts": {
    "dev": "python -m http.server 8123 --bind 127.0.0.1",
    "dev:hosted": "node scripts/dev.mjs",
    "test": "node test/run.mjs",
    "build": "node build.js",
    "desktop": "cargo tauri build",
    "desktop:dev": "cargo tauri dev",
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --lib -- --test-threads=1",
    "test:desktop": "node test/desktop.e2e.mjs",
    "lint:rust": "cargo fmt --manifest-path desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
